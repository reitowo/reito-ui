{
  "name": "reito-design-system",
  "version": "0.5.1",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run dev --workspace @reito/lab",
    "storybook": "npm run dev --workspace @reito/storybook",
    "tokens:build": "node scripts/build-tokens.mjs",
    "tokens:check": "node scripts/build-tokens.mjs --check",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "check": "npm run tokens:check && npm run catalog:check && node scripts/check-design.mjs && npm run tokens:audit && npm run typecheck",
    "tokens:audit": "node scripts/audit-design-tokens.mjs --check",
    "build": "npm run tokens:build && npm run catalog:build && npm run build --workspace @reito/ui && npm run build --workspace @reito/lab && npm run build --workspace @reito/storybook && npm run build --workspace @reito/workbench",
    "test:ui": "playwright test",
    "pack:ui": "npm run build --workspace @reito/ui && npm pack --workspace @reito/ui",
    "postinstall": "npm run tokens:build",
    "pack:library": "npm run tokens:build && npm run build --workspace @reito/ui && node scripts/pack-library.mjs",
    "test:storybook": "node scripts/check-storybook.mjs",
    "test:storybook:controls": "node scripts/check-storybook-controls.mjs",
    "catalog:build": "node scripts/build-catalog.mjs",
    "catalog:check": "node scripts/build-catalog.mjs --check",
    "dev:workbench": "npm run dev --workspace @reito/workbench"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "axe-core": "4.13.0",
    "shadcn": "4.21.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.2.2"
  }
}
