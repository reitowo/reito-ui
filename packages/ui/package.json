{
  "name": "@reito/ui",
  "version": "0.4.1",
  "type": "module",
  "description": "Reito UI: accessible graphite desktop React components",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./basic": {
      "types": "./dist/basic.d.ts",
      "import": "./dist/basic.js"
    },
    "./complex": {
      "types": "./dist/complex/index.d.ts",
      "import": "./dist/complex.js"
    },
    "./ai": {
      "types": "./dist/ai/index.d.ts",
      "import": "./dist/ai.js"
    }
  },
  "files": [
    "dist",
    "THIRD_PARTY_NOTICES.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "license": "MIT",
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json && node ../../scripts/finalize-ui.mjs",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@fontsource-variable/inter": "5.3.0",
    "@hookform/resolvers": "5.9.1",
    "@reito/tokens": "0.4.1",
    "@standard-schema/spec": "1.1.0",
    "@tanstack/react-table": "8.21.3",
    "@tanstack/react-virtual": "3.14.10",
    "@tiptap/core": "3.31.3",
    "@tiptap/extension-emoji": "3.31.3",
    "@tiptap/extension-list": "3.31.3",
    "@tiptap/extension-mention": "3.31.3",
    "@tiptap/extension-text-align": "3.31.3",
    "@tiptap/markdown": "3.31.3",
    "@tiptap/pm": "3.31.3",
    "@tiptap/react": "3.31.3",
    "@tiptap/starter-kit": "3.31.3",
    "@tiptap/suggestion": "3.31.3",
    "class-variance-authority": "0.7.1",
    "cmdk": "1.1.1",
    "cn": "0.2.5",
    "date-fns": "4.4.0",
    "input-otp": "1.5.0",
    "lucide-react": "1.41.0",
    "react-day-picker": "10.0.1",
    "react-hook-form": "7.87.0",
    "react-resizable-panels": "4.12.3",
    "refractor": "5.0.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.5.4"
  }
}
